  m_Script: {fileID: 11500000, guid: b0fb034029fb8544b8ae3ad75efa8f0f, type: 3}
  m_Name: T5 - End
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  lines:
  - speakerName: Echo-09
    portrait: {fileID: 21300000, guid: d5c0dd4781c7526498aab7fec666bd3a, type: 3}
    text: "\"Chassis compressed. It\u2019s a tight fit, but I\u2019m clear of the
      hopper. I can feel the heat radiating from the floor behind me.\"\r\n"
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: 5771d178524caf74cb6b43cc70771940, type: 3}
    text: '"Don''t look back. The floor is already starting to give way. Just keep
      moving into the dark, that''s where the truth is hiding."



'
  - speakerName: Echo-09
    portrait: {fileID: 21300000, guid: d5c0dd4781c7526498aab7fec666bd3a, type: 3}
    text: '"Redefining priority: Self-preservation. I am leaving the reclamation
      zone."



'
  - speakerName: Echo-09
    portrait: {fileID: 21300000, guid: 3a01f8957cca16948b115b58c1628d8f, type: 3}
    text: '"Thanks for your help, Eden."



'
