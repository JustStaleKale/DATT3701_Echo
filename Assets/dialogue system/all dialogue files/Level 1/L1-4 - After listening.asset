--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b0fb034029fb8544b8ae3ad75efa8f0f, type: 3}
  m_Name: L1-4 - After listening
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  lines:
  - speakerName: Echo-09
    portrait: {fileID: 21300000, guid: 52c34853bd203944d9626ed4e6ebd646, type: 3}
    text: '"I recognize this frequency. It is not noise."'
  - speakerName: Echo-09
    portrait: {fileID: 21300000, guid: 3a01f8957cca16948b115b58c1628d8f, type: 3}
    text: '"It is beautiful. I remember now. I didn''t save the machine, what I saved
      is this song."'
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: 5771d178524caf74cb6b43cc70771940, type: 3}
    text: "\"That song is the part of your rest memory, Echo-09. And it\u2019s the
      reason we have to find the Data Core.\""
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: 5771d178524caf74cb6b43cc70771940, type: 3}
    text: "\"There is more history trapped in the silence of this factory. And you\u2019re
      the only one who can feel them.\""
  - speakerName: Echo-09
    portrait: {fileID: 21300000, guid: d5c0dd4781c7526498aab7fec666bd3a, type: 3}
    text: "\"Let\u2019s move towards the Data Core, Eden. This world is too quiet.
      I want to hear the rest.\""
