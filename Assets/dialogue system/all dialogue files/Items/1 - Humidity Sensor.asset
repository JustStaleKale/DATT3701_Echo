%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b0fb034029fb8544b8ae3ad75efa8f0f, type: 3}
  m_Name: 1 - Humidity Sensor
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  lines:
  - speakerName: Echo-09
    portrait: {fileID: 21300000, guid: 1c5e6c4aadb48f84e8c400d8b76d7687, type: 3}
    text: '"Unkown object detected."'
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: 5771d178524caf74cb6b43cc70771940, type: 3}
    text: '"This sensor has been broken for 50 years. Its processor is overheating,
      mistaking the sound of leaking coolant for ''precipitation'' from the atmosphere."'
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: 5771d178524caf74cb6b43cc70771940, type: 3}
    text: "\"It\u2019s simulating a rain it has never seen, Echo. It thinks the world
      should feel cool.\""
  - speakerName: Echo-09
    portrait: {fileID: 21300000, guid: 52c34853bd203944d9626ed4e6ebd646, type: 3}
    text: '"Logic conflict: Water causes oxidation. Why is this unit cherishing the
      simulation?"'
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: 5771d178524caf74cb6b43cc70771940, type: 3}
    text: "\"Because for a moment, it isn't a machine in a factory. It\u2019s a witness
      to a world that was once alive.\""
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: b2235fcbf5a3d7947a9d612207cb51f9, type: 3}
    text: '"Keep it. It may prove to be useful later. There may be more fragements
      elsewhere too." '
