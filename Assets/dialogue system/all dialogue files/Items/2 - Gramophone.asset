%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b0fb034029fb8544b8ae3ad75efa8f0f, type: 3}
  m_Name: 2 - Gramophone
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  lines:
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: 5771d178524caf74cb6b43cc70771940, type: 3}
    text: "\"We're here. This is the unit you refused to feed into the shredder.
      It\u2019s still sealed, exactly how you left it before the Overseer\u2019s
      guards dragged you away.\""
  - speakerName: Echo-09
    portrait: {fileID: 21300000, guid: 52c34853bd203944d9626ed4e6ebd646, type: 3}
    text: "\"I can feel the smooth surface of the container. It's delicate. My sensors
      want to know what\u2019s inside.\""
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: b2235fcbf5a3d7947a9d612207cb51f9, type: 3}
    text: "\"It\u2019s a phonograph, 09. A device humans used to capture time and
      turn it into vibrations. And look... tucked under the lid is a photograph.
      It\u2019s an old man, sitting in a garden, listening to this very machine.
      He looks at peace.\""
  - speakerName: Echo-09
    portrait: {fileID: 21300000, guid: 52c34853bd203944d9626ed4e6ebd646, type: 3}
    text: '"Garden... Peace... These terms are not in my efficiency manual. But the
      photograph, why would a human capture a ''moment'' of stillness? It is not
      productive."'
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: b2235fcbf5a3d7947a9d612207cb51f9, type: 3}
    text: '"Because for them, the ''moment'' was the point of living, not the product.
      Try it, Echo-09. Lower the needle. Let the air vibrate one last time."'
