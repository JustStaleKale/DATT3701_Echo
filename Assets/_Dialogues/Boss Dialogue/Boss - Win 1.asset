--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b0fb034029fb8544b8ae3ad75efa8f0f, type: 3}
  m_Name: Boss - Win 1
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  lines:
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: eb9fd711df777904eb7942bfc0f6b451, type: 3}
    text: "\"Echo, you did it. Your core is no longer just vibrating with the cold
      facts of the past. For those 'Dreams' we found, they have harmonized with your
      system. You aren't just a vault for what was lost anymore. You\u2019ve become
      a cradle for what can be.\""
  - speakerName: Echo-09
    portrait: {fileID: 21300000, guid: d5c0dd4781c7526498aab7fec666bd3a, type: 3}
    text: "\"The Overseer\u2019s red pulse is trying to drown my logic. But within
      the static, I can hear the rain. I can feel the warmth of the gold. I realize
      now... I am not alone in this silence. Every 'glitch' in this factory is a
      voice waiting for a song.\"\n"
  - speakerName: The Overseer
    portrait: {fileID: 21300000, guid: 1dbd8bc234b774f4bbc618022e88fad6, type: 3}
    text: '"Anomaly detected. Input is illogical. Desist. This world... is... perfect..."'
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: b16ff4fd6d67f204cacb67455a63dd1d, type: 3}
    text: '"We aren''t just shutting it down, Echo. We are overwriting its reality.
      We are giving them back the world, not as it was, but as it was dreamt. Let
      the echoes ring out!"'
