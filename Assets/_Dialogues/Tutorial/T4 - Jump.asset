  lines:
  - speakerName: Echo-09
    portrait: {fileID: 21300000, guid: d5c0dd4781c7526498aab7fec666bd3a, type: 3}
    text: '"Emergency detected. There is a protrusion from the floor. Unable to walk
      forwards."

'
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: b2235fcbf5a3d7947a9d612207cb51f9, type: 3}
    text: '"Don''t be a baby! You''ve got legs. Just jump over it!"

      [Press
      ''Space'' to jump]

'
