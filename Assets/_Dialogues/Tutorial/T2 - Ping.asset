  m_Script: {fileID: 11500000, guid: b0fb034029fb8544b8ae3ad75efa8f0f, type: 3}
  m_Name: T2 - Ping
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  lines:
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: 5771d178524caf74cb6b43cc70771940, type: 3}
    text: '"Stop calculating, Echo-09. You''re trying to walk in a world you can''t
      see. Of course you''re hitting walls."'
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: 5771d178524caf74cb6b43cc70771940, type: 3}
    text: '"Feel the floor beneath your feet, listen to the way your footsteps ring.
      You have to project yourself into the dark. Try to fire a resonance pulse,
      let it arc through the air."

      [Press ''Left Mouse Button'' to shoot an
      echolocation pulse]

'
