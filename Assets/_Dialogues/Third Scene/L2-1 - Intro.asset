  m_Script: {fileID: 11500000, guid: b0fb034029fb8544b8ae3ad75efa8f0f, type: 3}
  m_Name: L2-1 - Intro
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  lines:
  - speakerName: Echo-09
    portrait: {fileID: 21300000, guid: 52c34853bd203944d9626ed4e6ebd646, type: 3}
    text: '"Environmental noise is reaching critical levels."'
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: 5771d178524caf74cb6b43cc70771940, type: 3}
    text: "\"The Overseer... it\u2019s trying to format the air itself. It doesn't
      want you to 'see' what\u2019s hidden here.\""
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: 5771d178524caf74cb6b43cc70771940, type: 3}
    text: '"Activate all the batteries to open the final door and escape!"

'
