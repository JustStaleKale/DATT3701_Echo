  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b0fb034029fb8544b8ae3ad75efa8f0f, type: 3}
  m_Name: L1-2 - puzzle
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  lines:
  - speakerName: Echo-09
    portrait: {fileID: 21300000, guid: d5c0dd4781c7526498aab7fec666bd3a, type: 3}
    text: '"Target identified: Heavy-duty blast door. Power levels are zero. The
      manual override is located in a room. It is out of physical reach."

'
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: 5771d178524caf74cb6b43cc70771940, type: 3}
    text: '"That''s by design. Maintenance drones were supposed to ping the internal
      sensors to open it."

'
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: 5771d178524caf74cb6b43cc70771940, type: 3}
    text: '"Your ''Sonic Bullet'' should have the same frequency. Aim for the window
      in the room and hit that battery to give that door a reason to wake up."

'
  - speakerName: Echo-09
    portrait: {fileID: 21300000, guid: d5c0dd4781c7526498aab7fec666bd3a, type: 3}
    text: '" Understood, calculating trajectory."



'
