  m_Script: {fileID: 11500000, guid: b0fb034029fb8544b8ae3ad75efa8f0f, type: 3}
  m_Name: Laser Intro
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  lines:
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: 5771d178524caf74cb6b43cc70771940, type: 3}
    text: '"The Overseer is isolating this floor! Don''t let those beams touch your
      core, it''s trying to format you along with the truth."'
  - speakerName: Echo-09
    portrait: {fileID: 21300000, guid: 1167f17592352d64eb4e876e7ef6a915, type: 3}
    text: '"It wants to erase the evidence. I won''t let myself become dead code."'
  - speakerName: Eden
    portrait: {fileID: 21300000, guid: 5771d178524caf74cb6b43cc70771940, type: 3}
    text: '"Watch the patterns, Echo! Every logic gate has a leak. Find the gap!"'
  - speakerName: Echo-09
    portrait: {fileID: 21300000, guid: 1167f17592352d64eb4e876e7ef6a915, type: 3}
    text: '"I see it. Even a perfect system has its blind spots."'
